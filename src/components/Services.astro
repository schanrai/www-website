---
import { Image } from 'astro:assets';
import SectionLabel from './ui/SectionLabel.astro';
import classTreePose from '../assets/images/class-tree-pose.png';
import aerialWatsu from '../assets/images/aerial-watsu.png';
import { CONTENT } from '../content/homepage';

const { services } = CONTENT;
---

<section class="services">
  <div class="services-inner">
    <div class="services-header">
      <SectionLabel color="var(--color-deep-teal)">{services.label}</SectionLabel>
      <h2 class="services-title">{services.title}</h2>
    </div>

    <div class="cards">
      <!-- Group Classes -->
      <article class="card">
        <div class="card-photo-wrap">
          <Image
            src={classTreePose}
            alt="Water Woman Wellness group aqua yoga class"
            class="card-photo"
            widths={[400, 700]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="lazy"
          />
        </div>
        <div class="card-body">
          <h3 class="card-title">{services.group.title}</h3>
          <p class="card-desc">{services.group.desc}</p>
          <p class="card-detail">{services.group.detail}</p>
          <button class="card-cta" data-open-inquiry type="button">{services.group.cta}</button>
        </div>
      </article>

      <!-- One-on-One Sessions -->
      <article class="card">
        <div class="card-photo-wrap">
          <Image
            src={aerialWatsu}
            alt="Water Woman Wellness one-on-one aqua yoga session"
            class="card-photo"
            widths={[400, 700]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="lazy"
          />
        </div>
        <div class="card-body">
          <h3 class="card-title">{services.priv.title}</h3>
          <p class="card-desc">{services.priv.desc}</p>
          <p class="card-detail">{services.priv.detail}</p>
          <button class="card-cta" data-open-inquiry type="button">{services.priv.cta}</button>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .services {
    background-color: var(--color-ivory);
    padding: var(--section-py) var(--section-px);
  }

  .services-inner {
    max-width: 1440px;
    margin: 0 auto;
  }

  .services-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 60px;
  }

  .services-title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 3vw + 0.5rem, 2.25rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.15;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .cards {
      flex-direction: row;
    }
  }

  .card {
    flex: 1;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--color-ivory-alt);
    border: 1px solid rgba(216, 199, 180, 0.14);
  }

  .card-photo-wrap {
    height: 300px;
    overflow: hidden;
  }

  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 32px 32px 36px;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw + 0.25rem, 1.5rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.2;
    margin-bottom: 14px;
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-body-light);
    line-height: 1.7;
    margin-bottom: 10px;
  }

  .card-detail {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-body-light);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .card-cta {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-gold);
    letter-spacing: 0.04em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 22px;
    border: 1.5px solid var(--color-gold);
    border-radius: 100px;
    background-color: transparent;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .card-cta:hover {
    background-color: var(--color-gold);
    color: var(--color-white);
    border-color: var(--color-gold);
  }
</style>
