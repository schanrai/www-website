---
import LaunchPill from './ui/LaunchPill.astro';
import { CONTENT } from '../content/homepage';

const { hero } = CONTENT;
---

<section class="hero-body">
  <div class="hero-body-inner">
    <div class="hero-body-left">
      <p class="hero-subheading">{hero.subheading}</p>
      <p class="hero-lead">{hero.lead}</p>
      <p class="hero-location">{hero.location}</p>
      <LaunchPill text={hero.launch} />
    </div>
    <div class="hero-body-right">
      <button class="cta-btn cta-btn--large" data-open-inquiry type="button">{hero.cta}</button>
    </div>
  </div>
</section>

<style>
  .hero-body {
    background-color: var(--color-ivory);
    padding: clamp(32px, 5vw, 48px) var(--section-px) clamp(40px, 6vw, 72px);
  }

  .hero-body-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .hero-body-inner {
      flex-direction: row;
      gap: 60px;
      align-items: flex-start;
      justify-content: space-between;
    }

    .hero-body-left {
      flex: 1;
      max-width: 850px;
    }

    .hero-body-right {
      flex: 0 0 auto;
      padding-top: 4px;
    }
  }

  .hero-subheading {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.125rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .hero-lead {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1vw + 0.5rem, 1rem);
    color: var(--color-body);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .hero-location {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.125rem);
    color: var(--color-body-light);
    line-height: 1.7;
    margin-bottom: 20px;
  }
</style>
