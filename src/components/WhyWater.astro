---
import SectionLabel from './ui/SectionLabel.astro';
import WaveLine from './ui/WaveLine.astro';
import { CONTENT } from '../content/homepage';

const { whyWater } = CONTENT;
---

<section class="why-water">
  <div class="why-water-inner">
    <SectionLabel color="var(--color-deep-teal)">{whyWater.label}</SectionLabel>
    <h2 class="why-water-title">{whyWater.title}</h2>
    <WaveLine width={100} height={12} class="wave-sep" />
    <p class="why-water-intro">{whyWater.intro}</p>
    <ul class="benefit-list" role="list">
      {whyWater.benefits.map((b) => (
        <li class="benefit-item">
          <span class="benefit-dot" aria-hidden="true"></span>
          <p class="benefit-text">
            <strong class="benefit-bold">{b.bold}</strong>
            <span class="benefit-desc"> — {b.text}</span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why-water {
    background-color: rgba(188, 231, 228, 0.25);
    padding: var(--section-py) clamp(20px, 8.3vw, 120px);
  }

  .why-water-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .why-water-title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 3vw + 0.5rem, 2.25rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .wave-sep {
    margin-bottom: 32px;
  }

  .why-water-intro {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1vw + 0.5rem, 1rem);
    color: var(--color-body);
    line-height: 1.7;
    max-width: 680px;
    margin-bottom: 48px;
    text-align: center;
  }

  .benefit-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
    width: 100%;
    list-style: none;
    text-align: left;
  }

  .benefit-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .benefit-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-deep-teal);
    margin-top: 8px;
    flex-shrink: 0;
  }

  .benefit-text {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-body);
    line-height: 1.7;
  }

  .benefit-bold {
    font-weight: 600;
    color: var(--color-deep-teal);
  }

  .benefit-desc {
    color: var(--color-body);
  }
</style>
