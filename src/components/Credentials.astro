---
import { CONTENT } from '../content/homepage';

const { about } = CONTENT;

function parseCert(cert: string): { name: string; issuer: string } {
  const [name, ...rest] = cert.split(',');
  return { name: (name ?? '').trim(), issuer: rest.join(',').trim() };
}
---

<div class="credentials-card">
  <!-- Certifications -->
  <div class="cred-section">
    <p class="cred-eyebrow">Certifications</p>
    {about.certifications.map((cert) => {
      const { name, issuer } = parseCert(cert);
      return (
        <div class="cred-entry">
          <p class="cred-name">{name}</p>
          {issuer && <p class="cred-issuer">{issuer}</p>}
        </div>
      );
    })}
  </div>

  <!-- Specialization -->
  <div class="cred-section cred-section--bordered">
    <p class="cred-eyebrow">Specialization</p>
    {about.specialization.map((cert) => {
      const { name, issuer } = parseCert(cert);
      return (
        <div class="cred-entry">
          <p class="cred-name">{name}</p>
          {issuer && <p class="cred-issuer">{issuer}</p>}
        </div>
      );
    })}
  </div>
</div>

<style>
  .credentials-card {
    margin-top: 28px;
    background-color: rgba(188, 231, 228, 0.25);
    border: 1px solid rgba(98, 199, 199, 0.14);
    border-radius: 16px;
    padding: 26px 28px;
  }

  .cred-section {
    margin-bottom: 0;
  }

  .cred-section--bordered {
    border-top: 1px solid rgba(98, 199, 199, 0.14);
    padding-top: 20px;
    margin-top: 20px;
  }

  .cred-eyebrow {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-aqua);
    margin-bottom: 14px;
  }

  .cred-entry {
    margin-bottom: 14px;
  }

  .cred-entry:last-child {
    margin-bottom: 0;
  }

  .cred-name {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.35;
  }

  .cred-issuer {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-body-light);
    margin-top: 2px;
  }
</style>
