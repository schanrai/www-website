---
import SectionLabel from './ui/SectionLabel.astro';
import { CONTENT } from '../content/homepage';

const { ctaBand } = CONTENT;
---

<section class="cta-band">
  <svg class="wave-top" viewBox="0 0 900 24" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M0 12 C72 2.88,153 2.88,225 12 S378 21.12,450 12 S603 2.88,675 12 S828 21.12,900 12" stroke="#62C7C7" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  </svg>
  <svg class="wave-bottom" viewBox="0 0 700 18" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M0 9 C44.8 2.16,100.8 2.16,140 9 S235.2 15.84,280 9 S375.2 2.16,420 9 S515.2 15.84,560 9 S655.2 2.16,700 9" stroke="#62C7C7" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  </svg>

  <div class="cta-band-inner">
    <h2 class="cta-band-title">{ctaBand.title}</h2>
    <p class="cta-band-body">{ctaBand.body}</p>
    <button class="cta-btn cta-btn--large" data-open-inquiry type="button">{ctaBand.cta}</button>
  </div>
</section>

<style>
  .cta-band {
    background-color: rgba(188, 231, 228, 0.25);
    padding: var(--section-py-sm) var(--section-px);
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .cta-band-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .wave-top,
  .wave-bottom {
    position: absolute;
    left: 0;
    width: 100%;
    pointer-events: none;
    display: block;
  }

  .wave-top {
    top: 14px;
    height: 26px;
    opacity: 0.3;
  }

  .wave-bottom {
    top: 38px;
    height: 20px;
    opacity: 0.2;
  }

  .cta-band-title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 3vw + 0.5rem, 2.25rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.15;
    margin-bottom: 12px;
    text-align: center;
  }

  .cta-band-body {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-body);
    line-height: 1.7;
    margin-bottom: 36px;
    text-align: center;
    max-width: 520px;
  }
</style>
