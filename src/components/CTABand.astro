---
import SectionLabel from './ui/SectionLabel.astro';
import WaveLine from './ui/WaveLine.astro';
import { CONTENT } from '../content/homepage';

const { ctaBand } = CONTENT;
---

<section class="cta-band">
  <WaveLine width={900} height={24} class="wave-top" />
  <WaveLine width={700} height={18} class="wave-bottom" />

  <div class="cta-band-inner">
    <h2 class="cta-band-title">{ctaBand.title}</h2>
    <p class="cta-band-body">{ctaBand.body}</p>
    <button class="cta-btn cta-btn--large" data-open-inquiry type="button">{ctaBand.cta}</button>
  </div>
</section>

<style>
  .cta-band {
    background-color: rgba(188, 231, 228, 0.25);
    padding: var(--section-py-sm) var(--section-px);
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .cta-band-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .wave-top {
    position: absolute;
    top: 16px;
    left: 0;
    width: 100%;
    opacity: 0.25;
    pointer-events: none;
  }

  .wave-bottom {
    position: absolute;
    bottom: 12px;
    left: 0;
    width: 100%;
    opacity: 0.15;
    pointer-events: none;
  }

  .cta-band-title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 3vw + 0.5rem, 2.25rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.15;
    margin-bottom: 12px;
    text-align: center;
  }

  .cta-band-body {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-body);
    line-height: 1.7;
    margin-bottom: 36px;
    text-align: center;
    max-width: 520px;
  }
</style>
