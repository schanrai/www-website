---
interface Props {
  currentPage?: '/' | '/seniors' | '/menopause';
}
const { currentPage = '/' } = Astro.props;

const navLinks = [
  { label: 'Menopause', href: '/menopause' },
  { label: 'Seniors', href: '/seniors' },
];

const visibleLinks = navLinks.filter(link => link.href !== currentPage);
---

<header>
  <nav>
    <a href="/" class="logo-link" aria-label="Water Woman Wellness — home">
      <img
        src="/images/Logo.png"
        alt="Water Woman Wellness"
        height="96"
        width="auto"
        loading="eager"
      />
    </a>

    <div class="nav-links">
      {visibleLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </div>

    <details class="nav-mobile">
      <summary class="nav-toggle" aria-label="Open menu">
        <span class="hamburger-icon" aria-hidden="true"></span>
      </summary>
      <div class="nav-mobile-menu">
        {visibleLinks.map(link => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
      </div>
    </details>
  </nav>
</header>

<style>
  header {
    background-color: var(--color-ivory-alt);
    border-bottom: 1px solid rgba(216, 199, 180, 0.19);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 105px;
    padding: 28px var(--section-px);
    max-width: 1440px;
    margin: 0 auto;
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: 0;
  }

  .logo-link img {
    height: clamp(60px, 8vw, 96px);
    width: auto;
    transition: opacity 0.2s ease;
  }

  .logo-link:hover img {
    opacity: 0.7;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    align-items: center;
    margin-left: 0;
    margin-right: -8px;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-deep-teal);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover {
    opacity: 0.7;
  }

  /* Mobile hamburger — hidden on desktop */
  .nav-mobile {
    display: none;
    position: relative;
  }

  .nav-toggle {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    color: var(--color-deep-teal);
  }

  .nav-toggle::-webkit-details-marker {
    display: none;
  }

  /* Three-line hamburger, morphs to an X when open */
  .hamburger-icon,
  .hamburger-icon::before,
  .hamburger-icon::after {
    content: '';
    display: block;
    width: 24px;
    height: 2px;
    background-color: currentColor;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .hamburger-icon {
    position: relative;
  }

  .hamburger-icon::before {
    position: absolute;
    top: -7px;
    left: 0;
  }

  .hamburger-icon::after {
    position: absolute;
    top: 7px;
    left: 0;
  }

  .nav-mobile[open] .hamburger-icon {
    background-color: transparent;
  }

  .nav-mobile[open] .hamburger-icon::before {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-mobile[open] .hamburger-icon::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-mobile-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    min-width: 160px;
    display: flex;
    flex-direction: column;
    background-color: var(--color-ivory-alt);
    border: 1px solid rgba(216, 199, 180, 0.19);
    box-shadow: 0 8px 24px rgba(6, 70, 83, 0.08);
    padding: 4px 20px;
  }

  .nav-mobile-menu .nav-link {
    padding: 6px 0;
  }

  @media (max-width: 540px) {
    nav {
      height: auto;
      padding: 16px var(--section-px);
    }

    .nav-links {
      display: none;
    }

    .nav-mobile {
      display: block;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        menu.removeAttribute('open');
      }
    });
  }
</script>
