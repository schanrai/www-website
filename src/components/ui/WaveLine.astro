---
interface Props {
  width?: number;
  height?: number;
  color?: string;
  strokeWidth?: number;
  class?: string;
}
const {
  width = 100,
  height = 12,
  color = '#62C7C7',
  strokeWidth = 1.5,
  class: className = '',
} = Astro.props;

const w = width;
const h = height;
const d = `M0 ${h * 0.5} C${w * 0.08} ${h * 0.12},${w * 0.17} ${h * 0.12},${w * 0.25} ${h * 0.5} S${w * 0.42} ${h * 0.88},${w * 0.5} ${h * 0.5} S${w * 0.67} ${h * 0.12},${w * 0.75} ${h * 0.5} S${w * 0.92} ${h * 0.88},${w} ${h * 0.5}`;
---

<svg
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  fill="none"
  class={className}
  aria-hidden="true"
>
  <path d={d} stroke={color} stroke-width={strokeWidth} />
</svg>
