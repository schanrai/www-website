---
interface Props {
  as?: 'p' | 'h1' | 'h2' | 'h3' | 'h4';
  color?: string;
  class?: string;
}
const { as: Tag = 'p', color, class: className = '' } = Astro.props;
const style = color ? `color: ${color}` : '';
---

<Tag class:list={['section-label', className]} style={style}>
  <slot />
</Tag>
