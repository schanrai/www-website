---
import { Image } from 'astro:assets';
import SectionLabel from './ui/SectionLabel.astro';
import Credentials from './Credentials.astro';
import portraitImg from '../assets/images/sushi-portrait.png';
import { CONTENT } from '../content/homepage';

const { about } = CONTENT;
---

<section class="about" id="about">
  <div class="about-inner">

    <!-- Left column: portrait + credentials -->
    <div class="about-left">
      <Image
        src={portraitImg}
        alt="Sushi Chanrai, founder of Water Woman Wellness"
        class="portrait"
        widths={[360, 720]}
        sizes="(min-width: 768px) 360px, 100vw"
        loading="lazy"
      />
      <Credentials />
    </div>

    <!-- Right column: story -->
    <div class="about-right">
      <SectionLabel color="var(--color-deep-teal)">{about.label}</SectionLabel>
      <h2 class="about-title">{about.title}</h2>

      <blockquote class="pull-quote">
        <p>{about.hook}</p>
      </blockquote>

      {about.story.map((p) => (
        <p class="story-para">{p}</p>
      ))}

      <p class="turning-point">{about.turning}</p>

      {about.resolution.map((p) => (
        <p class="story-para">{p}</p>
      ))}

      <p class="closing-quote">{about.closing}</p>

      <p class="signature">{about.signature}</p>
    </div>

  </div>
</section>

<style>
  .about {
    background-color: var(--color-ivory);
    padding: var(--section-py) var(--section-px);
  }

  .about-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .about-inner {
      flex-direction: row;
      gap: 60px;
    }

    .about-left {
      flex: 0 0 360px;
    }

    .about-right {
      flex: 1;
    }
  }

  .about-left {
    width: 100%;
  }

  @media (max-width: 767px) {
    .about-left {
      max-width: 360px;
    }
  }

  .portrait {
    width: 100%;
    height: 380px;
    object-fit: cover;
    object-position: center bottom;
    border-radius: 16px;
    display: block;
  }

  .about-title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 3vw + 0.5rem, 2.25rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.15;
    margin-bottom: 28px;
  }

  .pull-quote {
    border-left: 3px solid var(--color-aqua);
    padding-left: 24px;
    margin: 0 0 28px 0;
  }

  .pull-quote p {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.25rem);
    font-style: italic;
    color: var(--color-deep-teal);
    line-height: 1.5;
  }

  .story-para {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-body-light);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .turning-point {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.5;
    margin: 8px 0 16px;
  }

  .closing-quote {
    font-family: var(--font-body);
    font-size: 16px;
    font-style: italic;
    font-weight: 600;
    color: var(--color-deep-teal);
    margin-top: 8px;
    margin-bottom: 0;
  }

  .signature {
    font-family: var(--font-script);
    font-size: 38px;
    font-weight: 700;
    color: var(--color-deep-teal);
    margin-top: 45px;
    margin-bottom: 45px;
    line-height: 1.3;
  }
</style>
