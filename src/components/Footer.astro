---
interface Props {
  currentPage?: '/' | '/seniors' | '/menopause';
}
const { currentPage = '/' } = Astro.props;
---

<footer>
  <div class="footer-inner">
    <!-- Top row -->
    <div class="footer-top">
      <!-- Brand lockup -->
      <div class="brand-lockup">
        <div class="brand-mark-row">
          <img
            src="/images/Mark.png"
            alt="Water Woman Wellness mark"
            height="44"
            width="auto"
            class="brand-mark"
          />
          <span class="footer-tagline">Freedom in Movement</span>
        </div>
        <p class="footer-location">Hollywood, Broward County, South Florida</p>
      </div>

      <!-- Link columns -->
      <div class="footer-links">
        <div class="link-col">
          <p class="link-col-heading">Navigate</p>
          <a href="/menopause" class="footer-link">Menopause</a>
          <a href="/seniors" class="footer-link">Seniors</a>
        </div>
        <div class="link-col">
          <p class="link-col-heading">Connect</p>
          <a href="#" class="footer-link">
            <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
            @waterwomanwellness
          </a>
          <a href="tel:+19544082135" class="footer-link">
            <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            +1 (954) 408-2135
          </a>
          <a href="mailto:info@waterwomanwellness.com" class="footer-link">
            <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <polyline points="2,4 12,13 22,4"/>
            </svg>
            info@waterwomanwellness.com
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <hr class="footer-rule" />

    <!-- Bottom row -->
    <div class="footer-bottom">
      <div class="footer-legal-group">
        <p class="footer-legal">© 2026 Water Woman Wellness. All rights reserved.</p>
        <a href="/terms" class="footer-legal-link">Terms &amp; Conditions</a>
      </div>
      <p class="footer-brand">A Chikitsa LLC brand</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--color-deep-teal);
    padding: 48px var(--section-px) 32px;
  }

  .footer-inner {
    max-width: 1440px;
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    flex-wrap: wrap;
  }

  .brand-lockup {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .brand-mark-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-mark {
    height: 44px;
    width: auto;
    filter: brightness(0) invert(1);
    flex-shrink: 0;
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-size: 14px;
    font-style: italic;
    color: var(--color-white);
  }

  .footer-location {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-body-light);
    margin-top: 4px;
  }

  .footer-links {
    display: flex;
    gap: 60px;
    flex-shrink: 0;
  }

  .link-col {
    display: flex;
    flex-direction: column;
  }

  .link-col-heading {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-aqua);
    margin-bottom: 14px;
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-pale-aqua);
    margin-bottom: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: opacity 0.2s ease;
  }

  .link-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    opacity: 0.7;
  }

  .footer-link:hover {
    opacity: 0.75;
  }

  .footer-rule {
    border: none;
    border-top: 1px solid rgba(98, 199, 199, 0.15);
    margin: 32px 0 20px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-legal,
  .footer-brand {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-body-light);
  }

  .footer-legal-group {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-legal-link {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-body-light);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.2s ease;
  }

  .footer-legal-link:hover {
    opacity: 0.75;
  }

  @media (max-width: 600px) {
    .footer-top {
      flex-direction: column;
      gap: 32px;
    }

    .footer-links {
      gap: 32px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
