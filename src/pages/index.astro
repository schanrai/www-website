---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import HeroBody from '../components/HeroBody.astro';
import WhyWater from '../components/WhyWater.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import FacilityContactForm from '../components/FacilityContactForm.astro';
import dividerImg from '../assets/images/underwater-dance.jpg';
import { CONTENT } from '../content/homepage';

const { meta } = CONTENT;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalUrl={meta.canonicalUrl}
  ogImage={meta.ogImage}
  isHomepage={true}
>
  <Header currentPage="/" />

  <main>
    <HeroSection />
    <HeroBody />
    <WhyWater />
    <Services />

    <!-- Full-width image divider -->
    <div class="image-divider">
      <Image
        src={dividerImg}
        alt=""
        role="presentation"
        class="divider-photo"
        widths={[768, 1280, 1440]}
        sizes="100vw"
        loading="lazy"
      />
    </div>

    <About />
    <FAQ />
    <CTABand />
  </main>

  <!-- Inquiry modal — triggered by [data-open-inquiry] buttons sitewide -->
  <FacilityContactForm />

  <Footer currentPage="/" />
</BaseLayout>

<style>
  .image-divider {
    width: 100%;
    height: clamp(240px, 40vw, 640px);
    overflow: hidden;
  }

  .divider-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 24%;
    display: block;
  }
</style>
