---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import HeroBody from '../components/HeroBody.astro';
import WhyWater from '../components/WhyWater.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import dividerImg from '../assets/images/underwater-dance.jpg';
---

<BaseLayout
  title="Therapeutic Aqua Yoga for Women | Broward & North Miami"
  description="Therapeutic aqua yoga for women navigating chronic pain, menopause and healthy aging. Group and private classes in Broward & North Miami. August 2026."
  canonicalUrl="https://www.waterwomanwellness.com"
  isHomepage={true}
>
  <Header currentPage="/" />

  <main>
    <HeroSection />
    <HeroBody />
    <WhyWater />
    <Services />

    <!-- Full-width image divider -->
    <div class="image-divider">
      <Image
        src={dividerImg}
        alt=""
        role="presentation"
        class="divider-photo"
        widths={[768, 1280, 1440]}
        sizes="100vw"
        loading="lazy"
      />
    </div>

    <About />
    <FAQ />
    <CTABand />
  </main>

  <Footer currentPage="/" />
</BaseLayout>

<style>
  .image-divider {
    width: 100%;
    height: clamp(240px, 40vw, 640px);
    overflow: hidden;
  }

  .divider-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 24%;
    display: block;
  }
</style>
