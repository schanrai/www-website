---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FacilityContactForm from '../components/FacilityContactForm.astro';
import WaveLine from '../components/ui/WaveLine.astro';
import LaunchPill from '../components/ui/LaunchPill.astro';
import { MENOPAUSE } from '../content/menopause';

import heroImg from '../assets/images/aerial-watsu.png';
import bowImg from '../assets/images/underwater-bow.jpg';
import dividerImg from '../assets/images/underwater-dance.jpg';
const { meta, hero, heroBody, whatIs, whyWater, whatToExpect, meetSushi, ctaBand } = MENOPAUSE;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalUrl={meta.canonicalUrl}
>
  <Header currentPage="/menopause" />

  <main>

    <!-- ── 1. HERO ── -->
    <section class="hero">
      <Image
        src={heroImg}
        alt="Aqua yoga class with pool noodles"
        class="hero-photo"
        loading="eager"
        fetchpriority="high"
        widths={[768, 1280, 1440]}
        sizes="100vw"
      />
      <div class="hero-overlay">
        <div class="hero-overlay-inner">
          <h1 class="hero-headline">{hero.headline}</h1>
          <p class="hero-tagline">{hero.tagline}</p>
        </div>
      </div>
    </section>

    <!-- ── 2. HERO BODY ── -->
    <section class="hero-body">
      <div class="hero-body-inner">
        <div class="hero-body-left">
          <p class="hero-subheading">{heroBody.subheading}</p>
          <p class="hero-lead">{heroBody.lead}</p>
          <p class="hero-location">{whatToExpect.location}</p>
          <LaunchPill text={whatToExpect.launch} />
        </div>
        <div class="hero-body-right">
          <button class="cta-btn cta-btn--large" data-open-inquiry type="button">{heroBody.cta}</button>
        </div>
      </div>
    </section>

    <!-- ── 3. WHAT IS AQUA YOGA ── -->
    <section class="what-is">
      <div class="what-is-inner">
        <div class="what-is-text">
          <h2 class="section-title">{whatIs.label}</h2>
          <WaveLine width={100} height={12} class="wave-sep" />
          {whatIs.paragraphs.map((p) => (
            <p class="what-is-para">{p}</p>
          ))}
        </div>
        <div class="what-is-photo-wrap">
          <Image
            src={bowImg}
            alt="Underwater yoga bow pose"
            class="what-is-photo"
            widths={[400, 700]}
            sizes="(min-width: 768px) 45vw, 100vw"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- ── 4. IMAGE DIVIDER ── -->
    <div class="image-divider">
      <Image
        src={dividerImg}
        alt=""
        role="presentation"
        class="divider-photo"
        widths={[768, 1280, 1440]}
        sizes="100vw"
        loading="lazy"
      />
    </div>

    <!-- ── 5. WHY WATER EXERCISE WORKS ── -->
    <section class="why-water">
      <div class="why-water-inner">
        <h2 class="section-title">{whyWater.label}</h2>
        <WaveLine width={100} height={12} class="wave-sep" />
        <p class="why-water-intro">{whyWater.intro}</p>
        <ul class="benefit-list" role="list">
          {whyWater.benefits.map((b) => (
            <li class="benefit-item">
              <span class="benefit-dot" aria-hidden="true"></span>
              <p class="benefit-text">
                <strong class="benefit-bold">{b.bold}</strong>
                <span class="benefit-desc"> — {b.text}</span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── 6. WHAT TO EXPECT ── -->
    <section class="expect">
      <div class="expect-inner">
        <h2 class="section-title">{whatToExpect.label}</h2>
        <WaveLine width={100} height={12} class="wave-sep" />
        <p class="expect-body">{whatToExpect.body}</p>
        <p class="expect-growth">{whatToExpect.growth}</p>
      </div>
    </section>

    <!-- ── 7. MEET SUSHI ── -->
    <section class="meet-sushi">
      <div class="meet-sushi-inner">
        <h2 class="section-title">{meetSushi.label}</h2>
        <p class="meet-sushi-intro">{meetSushi.intro}</p>
        <a href={meetSushi.linkHref} class="meet-sushi-link">{meetSushi.linkText}</a>
      </div>
    </section>

    <!-- ── 8. CTA BAND ── -->
    <section class="cta-band">
      <WaveLine width={900} height={24} class="wave-top" />
      <WaveLine width={700} height={18} class="wave-bottom" />
      <div class="cta-band-inner">
        <h2 class="cta-band-title">{ctaBand.title}</h2>
        <p class="cta-band-body">{ctaBand.body}</p>
        <button class="cta-btn cta-btn--large" data-open-inquiry type="button">{ctaBand.cta}</button>
      </div>
    </section>

  </main>

  <FacilityContactForm />
  <Footer currentPage="/menopause" />
</BaseLayout>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
    width: 100%;
    min-height: 400px;
    overflow: hidden;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    min-height: 400px;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  @media (min-width: 768px) {
    .hero {
      height: clamp(400px, 56.3vw, 812px);
    }

    .hero-photo {
      position: absolute;
      inset: 0;
      min-height: unset;
    }
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(0deg, rgba(0, 61, 74, 0.88) 0%, rgba(0, 61, 74, 0) 100%);
    padding: clamp(80px, 12vw, 140px) var(--section-px) clamp(32px, 4vw, 52px);
  }

  .hero-overlay-inner {
    max-width: 1440px;
    margin: 0 auto;
  }

  .hero-headline {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw + 0.25rem, 2.5rem);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.2;
    margin-bottom: 10px;
    max-width: 880px;
  }

  .hero-tagline {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw + 0.25rem, 1.375rem);
    font-weight: 400;
    font-style: italic;
    color: var(--color-pale-aqua);
    line-height: 1.4;
  }

  /* ── HERO BODY ── */
  .hero-body {
    background-color: var(--color-ivory);
    padding: clamp(32px, 5vw, 48px) var(--section-px) clamp(40px, 6vw, 72px);
  }

  .hero-body-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .hero-body-inner {
      flex-direction: row;
      gap: 60px;
      justify-content: space-between;
    }

    .hero-body-left {
      flex: 1;
      max-width: 850px;
    }

    .hero-body-right {
      flex: 0 0 auto;
      padding-top: 4px;
    }
  }

  .hero-subheading {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw + 0.25rem, 1.125rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .hero-lead {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1vw + 0.5rem, 1rem);
    color: var(--color-body);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .hero-location {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1vw + 0.5rem, 1rem);
    color: var(--color-body-light);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  /* ── Shared section heading ── */
  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 3vw + 0.5rem, 2.25rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .wave-sep {
    margin-bottom: 24px;
  }

  /* ── WHAT IS AQUA YOGA ── */
  .what-is {
    background-color: rgba(188, 231, 228, 0.15);
    padding: var(--section-py) var(--section-px);
  }

  .what-is-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (min-width: 768px) {
    .what-is-inner {
      flex-direction: row;
      gap: 60px;
      align-items: flex-start;
    }

    .what-is-text {
      flex: 1;
    }

    .what-is-photo-wrap {
      flex: 0 0 40%;
      max-width: 480px;
    }
  }

  .what-is-para {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-body);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .what-is-para:last-of-type {
    margin-bottom: 0;
  }

  .what-is-photo {
    width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
    object-fit: cover;
  }

  /* ── WHY WATER ── */
  .why-water {
    background-color: rgba(188, 231, 228, 0.25);
    padding: var(--section-py) var(--section-px);
  }

  .why-water-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .why-water-intro {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1vw + 0.5rem, 1rem);
    color: var(--color-body);
    line-height: 1.7;
    max-width: 680px;
    margin-bottom: 48px;
    text-align: center;
  }

  .benefit-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
    width: 100%;
    list-style: none;
    text-align: left;
  }

  .benefit-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .benefit-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-deep-teal);
    margin-top: 8px;
    flex-shrink: 0;
  }

  .benefit-text {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-body);
    line-height: 1.7;
  }

  .benefit-bold {
    font-weight: 600;
    color: var(--color-deep-teal);
  }

  /* ── IMAGE DIVIDER ── */
  .image-divider {
    width: 100%;
    height: clamp(240px, 40vw, 640px);
    overflow: hidden;
  }

  .divider-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 24%;
    display: block;
  }

  /* ── WHAT TO EXPECT ── */
  .expect {
    background-color: rgba(188, 231, 228, 0.15);
    padding: var(--section-py) var(--section-px);
  }

  .expect-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .expect-body {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-body);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .expect-growth {
    font-family: var(--font-body);
    font-size: 15px;
    font-style: italic;
    color: var(--color-deep-teal);
    line-height: 1.7;
    margin-bottom: 24px;
  }


  /* ── MEET SUSHI ── */
  .meet-sushi {
    background-color: var(--color-ivory-alt);
    padding: var(--section-py-sm) var(--section-px);
  }

  .meet-sushi-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .meet-sushi-intro {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-body);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .meet-sushi-link {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-gold);
    letter-spacing: 0.04em;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }

  .meet-sushi-link:hover {
    opacity: 0.75;
  }

  /* ── CTA BAND ── */
  .cta-band {
    background-color: rgba(188, 231, 228, 0.25);
    padding: var(--section-py-sm) var(--section-px);
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .cta-band-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .wave-top {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0.25;
    pointer-events: none;
  }

  .wave-bottom {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0.15;
    pointer-events: none;
  }

  .cta-band-title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 3vw + 0.5rem, 2.25rem);
    font-weight: 600;
    color: var(--color-deep-teal);
    line-height: 1.15;
    margin-bottom: 12px;
    text-align: center;
  }

  .cta-band-body {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-body);
    line-height: 1.7;
    margin-bottom: 36px;
    text-align: center;
    max-width: 520px;
  }
</style>
